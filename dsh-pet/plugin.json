{
  "$schema": "https://raw.githubusercontent.com/jieapi/AiCode/main/plugins/schema/plugin.schema.json",
  "manifestVersion": 1,
  "id": "wxichen.dsh-pet",
  "name": {
    "default": "DSH Pet",
    "zh-CN": "AiCode 桌宠"
  },
  "version": "0.9.0",
  "publisher": "wxichen",
  "repository": "https://github.com/wxichen/aicode-plugins",
  "description": {
    "default": "A floating desktop pet adapted from dsh-pet for AiCode. It plays transparent animations, reacts to AiCode runs, speaks lines generated from a persona, and can be controlled by AI tools.",
    "zh-CN": "将 dsh-pet 适配到 AiCode 的悬浮桌宠：播放透明动画、响应 AiCode 运行状态、按人设生成台词，并支持 AI 工具控制与摸头喂食互动。"
  },
  "license": "MIT",
  "icon": "assets/logo.png",
  "engines": {
    "pluginApi": "^1.0.0"
  },
  "runtime": {
    "type": "javascript",
    "entry": "dist/main.js",
    "resident": true
  },
  "contributes": {
    "modelAccess": {
      "purpose": "按使用者配置的人设，为桌宠生成气泡台词与状态反馈"
    },
    "configPage": "pages/config.html",
    "overlay": {
      "purpose": "显示 AiCode 桌宠、运行状态和交互气泡",
      "surfaces": [
        {
          "id": "pet",
          "page": "pages/pet.html",
          "width": 200,
          "height": 200,
          "draggable": true,
          "snap": "both"
        }
      ]
    },
    "uiEntries": [
      {
        "id": "settings",
        "title": {
          "default": "DSH Pet Settings",
          "zh-CN": "桌宠设置"
        },
        "slot": "settings.ai",
        "page": "pages/config.html",
        "icon": "zap"
      },
      {
        "id": "music",
        "title": {
          "default": "KA Music",
          "zh-CN": "音乐搜索"
        },
        "slot": "drawer.footer",
        "page": "pages/config.html",
        "icon": "cloud"
      }
    ],
    "hooks": [
      {
        "id": "boot",
        "event": "app.started",
        "handler": "hooks.boot"
      },
      {
        "id": "enabled",
        "event": "plugin.enabled",
        "handler": "hooks.enabled"
      },
      {
        "id": "disabled",
        "event": "plugin.disabled",
        "handler": "hooks.disabled"
      },
      {
        "id": "run-started",
        "event": "agent.run.started",
        "handler": "hooks.runStarted"
      },
      {
        "id": "tool-started",
        "event": "agent.tool.started",
        "handler": "hooks.toolStarted"
      },
      {
        "id": "tool-finished",
        "event": "agent.tool.finished",
        "handler": "hooks.toolFinished"
      },
      {
        "id": "run-finished",
        "event": "agent.run.finished",
        "handler": "hooks.runFinished"
      }
    ],
    "tools": [
      {
        "id": "say",
        "title": {
          "default": "Pet Says",
          "zh-CN": "让桌宠说话"
        },
        "description": {
          "default": "Show a short message in the AiCode floating pet bubble.",
          "zh-CN": "让 AiCode 桌宠显示一条简短气泡消息。"
        },
        "inputSchema": "schemas/say.input.json",
        "handler": "tools.say"
      },
      {
        "id": "play",
        "title": {
          "default": "Play Pet Animation",
          "zh-CN": "播放桌宠动作"
        },
        "description": {
          "default": "Play one of the bundled pet animations.",
          "zh-CN": "播放插件内置的一段桌宠透明动画。"
        },
        "inputSchema": "schemas/play.input.json",
        "handler": "tools.play"
      },
      {
        "id": "sleep",
        "title": {
          "default": "Toggle Pet Sleep",
          "zh-CN": "切换桌宠睡眠"
        },
        "description": {
          "default": "Put the pet to sleep, wake it up, or toggle its sleep state.",
          "zh-CN": "让桌宠睡觉、叫醒，或切换当前睡眠状态。"
        },
        "inputSchema": "schemas/sleep.input.json",
        "handler": "tools.sleep"
      },
      {
        "id": "interact",
        "title": {
          "default": "Interact With Pet",
          "zh-CN": "和桌宠互动"
        },
        "description": {
          "default": "Pet or feed the floating pet, or ask it to cheer you up. Raises its mood and shows a response line.",
          "zh-CN": "摸头、喂食或请桌宠说句鼓励的话，会提升心情值并显示一句回应。"
        },
        "inputSchema": "schemas/interact.input.json",
        "handler": "tools.interact"
      },
      {
        "id": "searchMusic",
        "title": {
          "default": "Search Music",
          "zh-CN": "搜索歌曲"
        },
        "description": {
          "default": "Search Kugou songs by keyword and return title, singer, album, hash and duration.",
          "zh-CN": "按关键词搜索酷狗歌曲，返回歌名、歌手、专辑、文件哈希与时长。"
        },
        "inputSchema": "schemas/music-search.input.json",
        "handler": "tools.searchMusic"
      },
      {
        "id": "musicAccount",
        "title": {
          "default": "Music Account",
          "zh-CN": "音乐账号状态"
        },
        "description": {
          "default": "Report whether a Kugou account is signed in.",
          "zh-CN": "查询当前是否已登录音乐账号，返回昵称与用户 ID。"
        },
        "inputSchema": "schemas/music-account.input.json",
        "handler": "tools.musicAccount"
      },
      {
        "id": "sing",
        "title": {
          "default": "Pet Sings",
          "zh-CN": "让桌宠唱歌"
        },
        "description": {
          "default": "Pick a random song from the favorites and play it on the floating pet.",
          "zh-CN": "从收藏歌单里随机挑一首歌，由桌宠悬浮窗播放。"
        },
        "inputSchema": "schemas/sing.input.json",
        "handler": "tools.sing"
      }
    ]
  }
}
